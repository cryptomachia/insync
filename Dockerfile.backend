# Fastify + SQLite indexer/API. Native better-sqlite3 needs build tools.
FROM node:20-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
# Install workspace packages (@handoff/*) at the root, then the backend's own deps.
RUN npm install --no-audit --no-fund
RUN cd backend && npm install --no-audit --no-fund
WORKDIR /app/backend
# Railway injects PORT; the server reads it. DATABASE_PATH points at the mounted volume.
CMD ["npm", "run", "start"]
