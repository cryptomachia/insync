# ============================================================================
# Handoff — root env template. Copy to `.env` (gitignored) and fill in as needed.
# With MOCK=true the whole stack runs locally with NO third-party accounts.
# Every var the apps read is listed here with a placeholder — NO real secrets.
# Per-module templates also exist: apps/web/.env.local.example, backend/.env.example,
# cre/.env.example. `make deploy` fills the *_ADDRESS vars after a local deploy.
# ============================================================================

# ---- Global mock switch: true = run everything locally, no third-party accounts ----
MOCK=true
NEXT_PUBLIC_MOCK=true

# ---- Chain ----
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Deployer / local-keeper key. This is the WELL-KNOWN anvil default account 0 —
# safe for local dev ONLY. NEVER put a real funded private key here, and never
# commit a real .env (it is gitignored).
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---- Contract addresses (filled by `make deploy`; or paste a live deployment) ----
USDC_ADDRESS=
ESCROW_ADDRESS=
REPUTATION_ADDRESS=
# Data Streams verifier proxy. Leave blank / address(0) → only stable (USDC) deals.
VERIFIER_PROXY_ADDRESS=

# ============================================================================
# Frontend (Next.js). NEXT_PUBLIC_* are inlined into the client bundle at build.
# ============================================================================
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_REPUTATION_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_VERIFIER_PROXY_ADDRESS=
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8787
NEXT_PUBLIC_DATASTREAMS_FEED_ETHUSD=ETH/USD
# Mock-mode signer override: which anvil key the mock auth provider "logs in" as.
# Defaults to anvil account 0 if unset.
NEXT_PUBLIC_MOCK_PK=

# ---- Dynamic (auth) — leave blank in mock mode ----
NEXT_PUBLIC_DYNAMIC_ENV_ID=

# ---- Blink (funding) — leave blank in mock mode ----
# Public merchant id is safe to inline; the merchant PRIVATE KEY (below) is server-only.
NEXT_PUBLIC_BLINK_MERCHANT_ID=
BLINK_MERCHANT_ID=
# Path to the server-side Blink signer route (defaults to /api/sign-payment).
NEXT_PUBLIC_BLINK_SIGNER_PATH=/api/sign-payment
# Merchant signing key for the Blink signer endpoint — SERVER-SIDE ONLY, NEVER
# NEXT_PUBLIC, NEVER committed. Provide ONE of these (base64-encoded PEM preferred):
MERCHANT_PRIVATE_KEY_B64=
MERCHANT_PRIVATE_KEY=
# Legacy/alt Blink key var (kept for compatibility; current flow uses the signer above).
NEXT_PUBLIC_BLINK_API_KEY=

# ============================================================================
# Chainlink Data Streams (leave blank in mock mode; getReport() returns 0x)
# ============================================================================
CHAINLINK_DATASTREAMS_API_KEY=
CHAINLINK_DATASTREAMS_API_SECRET=
DATASTREAMS_FEED_ETHUSD=ETH/USD
# Override the Data Streams API host (defaults to the testnet data engine host).
DATASTREAMS_API_HOST=

# ---- Backend ----
PORT=8787
DATABASE_PATH=./backend/handoff.db

# ============================================================================
# CRE local keeper / scan tools (the live workflow reads cre/config.json instead)
# ============================================================================
BACKEND_URL=http://127.0.0.1:8787
CRE_WORKFLOW_NAME=handoff-reclaim
# Highest dealId the local keeper scans (deals are contiguous 1..N).
CRE_MAX_DEAL_ID=200
# Interval (ms) for the keeper's --watch mode.
CRE_INTERVAL_MS=30000

# ---- Misc ----
# Set to any value to enable verbose debug logging in the devx scripts.
HANDOFF_DEBUG=
