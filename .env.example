# ---- Global mock switch: true = run everything locally with no third-party accounts ----
MOCK=true
NEXT_PUBLIC_MOCK=true

# ---- Chain ----
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Deployer / keeper key (anvil default account 0). DO NOT use a real key here.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---- Contract addresses (filled by scripts/deploy) ----
USDC_ADDRESS=
ESCROW_ADDRESS=
REPUTATION_ADDRESS=
VERIFIER_PROXY_ADDRESS=

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_REPUTATION_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8787
NEXT_PUBLIC_DATASTREAMS_FEED_ETHUSD=ETH/USD
# Live keys (leave blank in mock mode)
NEXT_PUBLIC_DYNAMIC_ENV_ID=
NEXT_PUBLIC_BLINK_API_KEY=

# ---- Chainlink Data Streams (leave blank in mock mode) ----
CHAINLINK_DATASTREAMS_API_KEY=
CHAINLINK_DATASTREAMS_API_SECRET=
DATASTREAMS_FEED_ETHUSD=ETH/USD

# ---- Backend ----
PORT=8787
DATABASE_PATH=./backend/handoff.db

# ---- CRE ----
BACKEND_URL=http://127.0.0.1:8787
CRE_WORKFLOW_NAME=handoff-reclaim
