# ---- Dependencies ----
node_modules/

# ---- Lockfiles (this is a multi-package demo repo; we don't commit locks) ----
package-lock.json
pnpm-lock.yaml
yarn.lock

# ---- JS / TS build output ----
dist/
build/
out/
.next/
coverage/
*.tsbuildinfo

# ---- Foundry ----
# forge-installed deps (forge-std, OpenZeppelin) — scoped to contracts/ so it does
# not also match apps/web/lib (app source). Reinstall with `forge install`.
/contracts/lib/
cache/
**/cache/
# Foundry writes the deployer PRIVATE KEY into broadcast/<script>/<chain>/run-latest.json.
# NEVER commit broadcast output.
broadcast/
**/broadcast/
artifacts/
typechain-types/
.foundry/

# ---- Secrets & local config (NEVER commit) ----
.env
.env.local
.env.*.local
secrets.json
*.pem
*.key

# ---- Local databases ----
*.db
*.sqlite
*.sqlite3

# ---- Test artifacts ----
playwright-report/
test-results/

# ---- Dev scratch dir (anvil pid, deploy snapshot, service logs) ----
.handoff/

# ---- Logs / OS ----
*.log
.DS_Store

# sqlite sidecar files (runtime)
*.db-shm
*.db-wal
*.db-journal
