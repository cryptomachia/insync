# ============================================================================
# cre/.env.example — env for the LOCAL keeper + scan scripts (SPEC §14).
# Copy to cre/.env (gitignored) and fill in addresses after deploying Escrow.
#
# The CRE *workflow* (src/workflow.ts) does NOT read these — its config comes
# from config.json via the CRE runtime. These vars drive the offline Node tools:
#   keeper.local.ts, scan-deals.ts, keeper.dry-run.ts
# ============================================================================

# Global mock switch: true = run everything locally, no third-party accounts.
MOCK=true

# ---- Chain ----
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Keeper key that signs reclaimExpired locally. Anvil default account 0.
# DO NOT use a real key. In live CRE mode the DON signs instead (no key here).
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---- Contracts (filled by scripts/deploy) ----
ESCROW_ADDRESS=
# Configured stable token (USDC). Deals in any OTHER token are volatile and the
# keeper fetches a Data Streams report for them. Leave blank → all deals stable.
USDC_ADDRESS=

# ---- Backend (/notify, optional GET /deals source) ----
BACKEND_URL=http://127.0.0.1:8787

# ---- Data Streams (leave blank in mock mode; getReport() returns 0x) ----
DATASTREAMS_FEED_ETHUSD=ETH/USD
CHAINLINK_DATASTREAMS_API_KEY=
CHAINLINK_DATASTREAMS_API_SECRET=

# ---- Keeper tuning ----
# Highest dealId to scan (deals are contiguous 1..N; scan stops at first gap).
CRE_MAX_DEAL_ID=200
# Interval for `--watch` mode.
CRE_INTERVAL_MS=30000

# ---- Live CRE deploy only (not needed for local/simulate) ----
CRE_WORKFLOW_NAME=handoff-reclaim
# CRE_* account/DON settings come from `cre login`; see README "Live deploy".
