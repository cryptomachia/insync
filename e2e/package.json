{
  "name": "@handoff/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Handoff integration tests: Playwright UI flows + viem script-level contract e2e (SPEC §13).",
  "scripts": {
    "test": "npm run test:contract && npm run test:ui",
    "test:contract": "tsx scripts/contract-e2e.ts",
