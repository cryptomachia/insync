    "test:ui:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@handoff/contracts-abi": "file:../packages/contracts-abi",
    "@handoff/datastreams": "file:../packages/datastreams",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
